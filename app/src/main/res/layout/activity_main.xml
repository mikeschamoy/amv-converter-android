            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUTO → analyzing when a file is selected" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="11dp" android:id="@+id/pictureInfo" />
            <Button android:id="@+id/pictureCompareButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Compare Sharp ↔ Smooth • same frame" android:textAllCaps="false" android:textColor="@color/text" android:background="@drawable/button_selector" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SUBTITLES • OPTIONAL" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/subsOffButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="OFF" android:background="@drawable/button_selector" android:textColor="@color/text" android:textAllCaps="false" />
                <Button android:id="@+id/subsForcedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="FORCED" android:background="@drawable/button_selector" android:textColor="@color/text" android:textAllCaps="false" />
                <Button android:id="@+id/subsTextButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="FIRST TEXT" android:background="@drawable/button_selector" android:textColor="@color/text" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/subsNormalButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="NORMAL TEXT" android:background="@drawable/button_selector" android:textColor="@color/text" android:textAllCaps="false" />
                <Button android:id="@+id/subsLargeButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="LARGE TEXT" android:background="@drawable/button_selector" android:textColor="@color/text" android:textAllCaps="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Off excludes selectable tracks (and keeps picture clean); Forced uses flagged text tracks; First Text prefers an English text track (otherwise first available). Embedded-on-picture subtitles cannot be removed. Bitmap subtitles are not supported for burn-in." android:textColor="@color/muted" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FRAMING • AUTO 184–216px GUARANTEED (ADVANCED OVERRIDES ALSO LIMITED)" android:textColor="@color/muted" android:textSize="11sp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/autoFrameButton" android:layout_width="90dp" android:layout_height="wrap_content" android:background="@drawable/button_selector" android:text="AUTO" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" />
