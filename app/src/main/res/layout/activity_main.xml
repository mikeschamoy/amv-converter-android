            </LinearLayout>
            <TextView android:id="@+id/stateBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/card_green" android:padding="8dp" android:text="READY" android:textColor="@color/green" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
