        <Button android:id="@+id/discardQueueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/button_selector" android:text="DISCARD REMAINING QUEUE" android:contentDescription="Discard unconverted queue items after confirmation" android:textColor="@color/muted" android:visibility="gone" android:minHeight="48dp" android:textAllCaps="false" android:textSize="13sp" />
        <LinearLayout android:id="@+id/queuePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/card" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
            <TextView android:id="@+id/queueHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QUEUE" android:textColor="@color/green" android:textStyle="bold" />
            <LinearLayout android:id="@+id/queueList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="QUEUE SETTINGS" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/queueAutoButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="AUTO EACH FILE" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/queueSameButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="SAME FOR ALL" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <Button android:id="@+id/queueDownloadsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/button_primary" android:text="START QUEUE → DOWNLOADS" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            <Button android:id="@+id/queueFolderButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/button_selector" android:text="CHOOSE ANOTHER FOLDER" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/sourceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/card" android:fontFamily="monospace" android:padding="14dp" android:text="SOURCE\n—" android:textColor="@color/text" android:textSize="12sp" android:lineSpacingExtra="3dp" android:visibility="gone" />
        <TextView android:id="@+id/autoSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:padding="12dp" android:background="@drawable/card_green" android:text="AUTO READY • Select a file to see your recommended conversion" android:textColor="@color/text" android:textSize="13sp" /><Button android:id="@+id/advancedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/button_selector" android:text="CUSTOMIZE ▾ • OPTIONAL SETTINGS" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp" android:id="@+id/previewPanel" android:visibility="gone">
            <LinearLayout android:id="@+id/customizePrimaryPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="Auto is recommended for most videos. Only change these options if your player needs different framing, subtitles, or file size." android:textColor="@color/muted" android:textSize="12sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="CONTENT TYPE" android:textColor="@color/muted" android:textSize="11sp" />
            <Button android:id="@+id/autoTypeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUTO • RECOMMENDED" android:textAllCaps="false" android:background="@drawable/button_selector" android:textColor="@color/text" android:minHeight="50dp" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/youtubeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="YouTube" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/movieButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="Movie" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/cartoonButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="Cartoon" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/portraitButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="Portrait" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="QUALITY • FILE SIZE" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/spaceSaverButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="SPACE SAVER" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/standardButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="STANDARD" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/qualityButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="QUALITY" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="PERFORMANCE • STANDARD RECOMMENDED" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/perfStandardButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="STANDARD" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/perfFasterButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="FASTER" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/perfMaximumButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="MAXIMUM" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PICTURE PROCESSING • AUTO RECOMMENDED" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="11dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/pictureAutoButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="2dp" android:text="AUTO" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/button_selector" android:textColor="@color/text" />
                <Button android:id="@+id/pictureSharpButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_margin="2dp" android:text="SHARP" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/button_selector" android:textColor="@color/text" />
