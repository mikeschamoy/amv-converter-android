            </LinearLayout>
            <LinearLayout android:id="@+id/portraitRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                <Button android:id="@+id/portraitFit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="FIT" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/portraitZoom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="ZOOM" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/portraitRotate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="ROTATE 90°" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FRAME RATE" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/fps15" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="15" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/fps25" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="25" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/fps30" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="30" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/fpsAuto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="AUTO" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/outputNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:background="@drawable/card_green" android:fontFamily="monospace" android:padding="12dp" android:text="OUTPUT\n—" android:textColor="@color/green" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <Button android:id="@+id/detectBarsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="DETECT BARS" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
                <Button android:id="@+id/clearCropButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_selector" android:text="CLEAR CROP" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            </LinearLayout>
            <CheckBox android:id="@+id/autoBarsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto-detect substantial baked-in black bars (each file)" android:checked="true" android:textColor="@color/text" />
            <TextView android:id="@+id/cropText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No detected crop." android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="TRIM • OPTIONAL" android:textColor="@color/muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/startTrim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Start 0:00" android:inputType="text" android:textColor="@color/text" android:textColorHint="@color/muted" android:minHeight="50dp" android:singleLine="true" android:textSize="14sp" android:padding="9dp" />
                <EditText android:id="@+id/endTrim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="End" android:inputType="text" android:textColor="@color/text" android:textColorHint="@color/muted" android:minHeight="50dp" android:singleLine="true" android:textSize="14sp" android:padding="9dp" />
            </LinearLayout>
            <CheckBox android:id="@+id/testClip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="30-second test clip" android:textColor="@color/text" />
        </LinearLayout>
        <Button android:id="@+id/saveAsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONVERT • SAVE AS…" android:textAllCaps="false" android:background="@drawable/button_selector" android:textColor="@color/text" android:minHeight="50dp" /></LinearLayout><TextView android:id="@+id/estimateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/card" android:fontFamily="monospace" android:padding="12dp" android:text="STORAGE\n—" android:textColor="@color/text" android:visibility="gone" />
        <LinearLayout android:id="@+id/advancedPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
            <TextView android:id="@+id/presetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="—" android:textColor="@color/green" android:textSize="12sp" />
            <Button android:id="@+id/exportDiagnosticsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/button_selector" android:text="EXPORT DIAGNOSTICS" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
            <Button android:id="@+id/resetDefaultsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/button_selector" android:text="RESTORE DEFAULTS" android:textColor="@color/text" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        </LinearLayout>
        <Button android:id="@+id/convertButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/button_primary" android:enabled="false" android:text="CONVERT → DOWNLOADS" android:textColor="@color/text" android:minHeight="62dp" android:textAllCaps="false" android:textSize="15sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_green" android:padding="12dp" android:textColor="@color/text" android:textSize="14sp" android:visibility="gone" /><Button android:id="@+id/startQueueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/button_primary" android:enabled="false" android:text="CHOOSE OUTPUT FOLDER &amp; START QUEUE" android:textColor="@color/text" android:visibility="gone" android:minHeight="62dp" android:textAllCaps="false" android:textSize="15sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/button_selector" android:text="CANCEL" android:textColor="@color/red" android:visibility="gone" android:minHeight="50dp" android:textAllCaps="false" android:textSize="13sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="10dp" android:max="100" android:progress="0" android:visibility="gone" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready." android:textColor="@color/muted" />
        <TextView android:id="@+id/telemetryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Speed: — • CPU: Standard • Thermal: — • Battery: —" android:textColor="@color/green" android:fontFamily="sans" android:textSize="12sp" android:background="@drawable/status_panel" android:padding="12dp" android:lineSpacingExtra="4dp" android:visibility="gone" />
        <Button android:id="@+id/historyToggleButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="SHOW RECENT FILES ▾" android:background="@drawable/button_selector" android:textColor="@color/text" android:minHeight="48dp" android:textAllCaps="false" android:textSize="13sp" />
        <TextView android:id="@+id/historyText" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card" android:fontFamily="monospace" android:padding="15dp" android:text="RECENT\nNo conversions yet." android:textColor="@color/muted" android:textSize="11sp" android:lineSpacingExtra="5dp" />
    </LinearLayout>
</ScrollView>