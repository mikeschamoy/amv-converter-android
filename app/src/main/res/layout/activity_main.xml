            </com.mikeschamoy.amvconverter.PlayerPreviewFrame>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="4dp" android:text="▶ plays original video • RENDER 10S shows the calibrated AMV preview" android:textSize="11sp" android:textColor="@color/muted" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <Button android:id="@+id/playPreviewButton" android:layout_width="88dp" android:layout_height="64dp" android:background="@drawable/button_selector" android:contentDescription="Toggle preview playback" android:text="▶" android:textSize="26sp" android:gravity="center" android:textColor="@color/text" android:minHeight="64dp" android:textAllCaps="false" android:layout_margin="2dp" android:includeFontPadding="false" />
