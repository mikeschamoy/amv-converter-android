                </LinearLayout>
            </HorizontalScrollView>
            </LinearLayout><TextView android:id="@+id/reasonText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/card" android:padding="10dp" android:text="Select a video to see actual framing and output dimensions" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="VIDEO PREVIEW • GEN 2" android:textColor="@color/muted" android:textSize="11sp" />
