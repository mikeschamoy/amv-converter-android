            <Button android:id="@+id/selectQueueButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/button_selector" android:text="SELECT QUEUE" android:textColor="@color/text" android:minHeight="62dp" android:textAllCaps="false" android:textSize="15sp" android:layout_margin="2dp" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/fileText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No media selected" android:textColor="@color/muted" android:maxLines="2" android:padding="4dp" />
